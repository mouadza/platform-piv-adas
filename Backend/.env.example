# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# JWT / throttling
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_HOURS=12
DRF_ANON_THROTTLE_RATE=100/hour
DRF_USER_THROTTLE_RATE=1000/hour
OTP_REQUEST_THROTTLE_RATE=5/hour
OTP_VERIFY_THROTTLE_RATE=10/hour
ADMIN_LOGIN_THROTTLE_RATE=5/min

# OTP
OTP_ALLOWED_EMAIL_DOMAINS=stellantis.com,external.stellantis.com
OTP_EXPIRATION_MINUTES=10
OTP_HISTORY_LIMIT=10
OTP_BOOTSTRAP_ADMIN_EMAILS=ta45177@stellantis.com

# Email SMTP
# Ask Stellantis IT for the approved SMTP host, port, and auth method.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your.sender@stellantis.com
EMAIL_HOST_PASSWORD=your_smtp_or_app_password_here
DEFAULT_FROM_EMAIL=your.sender@stellantis.com

# RabbitMQ / Celery / Redis
RABBITMQ_DEFAULT_USER=validation
RABBITMQ_DEFAULT_PASS=validation_rabbitmq
CELERY_BROKER_URL=amqp://validation:validation_rabbitmq@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800
CELERY_EMAIL_ASYNC=false
CELERY_EMAIL_FALLBACK_SYNC=true

# PostgreSQL (Docker Compose local)
DB_ENGINE=postgresql
DB_NAME=validation_app
DB_USER=validation_app
DB_PASSWORD=change-this-local-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true
POSTGRES_DB=validation_app
POSTGRES_USER=validation_app
POSTGRES_PASSWORD=change-this-local-postgres-password

# Optional SQLite fallback outside Docker
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# Production HTTPS
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
USE_X_FORWARDED_PROTO=false
